PORT=4000
NODE_ENV=development

# Sesión / JWT:
# JWT_SECRET: clave para firmar los tokens de sesión. Genera una propia (p. ej. con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=cambia-este-secreto-por-uno-seguro
JWT_EXPIRES_IN=604800

# URL pública del frontend (usada en los enlaces de verificación por correo)
CLIENT_URL=http://localhost:5173

# Envío de correos de verificación.
# Brevo (recomendado en la nube, funciona por HTTPS): crea una API key en
# https://app.brevo.com/settings/keys/smtp y verifica un remitente en
# https://app.brevo.com/senders/ (clic en "Verificar dirección").
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=DisplayEvent

# SMTP (alternativa local, solo se usa si Brevo no está configurado).
# Ej. Gmail usa smtp.gmail.com:465 con SSL (SMTP_SECURE=true) y contraseña de aplicación.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=DisplayEvent

# PostgreSQL (Supabase / Render / local)
# Opción A: cadena de conexión completa (Recomendada para Supabase y Render)
DATABASE_URL=postgres://usuario:password@host:5432/displayevent

# Opción B: credenciales por separado (alternativa a DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=tu_password
# DB_NAME=displayevent

# Cloudinary (opcional) - si se dejan vacías las imágenes se guardan en server/uploads/
# Para subida unsigned (recomendado): crea un "Upload Preset" sin firma en Cloudinary
# (Settings > Upload > Add upload preset > Signing mode: Unsigned) y pon su nombre aquí.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_PRESET=
# Alternativa: API key/secret con permisos de subida (si no usas el preset)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=