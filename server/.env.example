PORT=4000

# PostgreSQL (Supabase / Render / local)
# Opción A: cadena de conexión completa (Recomendada para Supabase y Render)
DATABASE_URL=postgres://usuario:password@host:5432/displayevent

# Opción B: credenciales por separado (alternativa a DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=tu_password
# DB_NAME=displayevent

# Cloudinary (opcional) - si se dejan vacías las imágenes se guardan en server/uploads/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=